# 早鸟工作台推送凭据模板
# 用法：cp config/credentials_template.env config/credentials.env
#       填入真实值后执行 chmod 600 config/credentials.env
# 本模板不含任何真实凭据，可安全提交。

# 发件邮箱（QQ 邮箱需开启 SMTP 服务并生成授权码）
QQ_EMAIL_FROM=
# QQ 邮箱 SMTP 授权码（不是登录密码）
QQ_EMAIL_AUTH_CODE=
# 收件地址，多个用英文逗号分隔
QQ_EMAIL_TO=
# SMTP 服务器，QQ 邮箱固定为 smtp.qq.com
QQ_SMTP_HOST=smtp.qq.com
# 465=SSL，587=STARTTLS
QQ_SMTP_PORT=465
QQ_SMTP_USE_SSL=true

# 是否启用常驻定时调度（true/false）
EARLY_BIRD_SCHEDULER_ENABLED=true
# 推送详细程度：concise=精简版（推荐）/ full=完整版 / notice=仅提醒
EARLY_BIRD_PUSH_MODE=concise
# 空结果日推送策略：per_domain=逐领域报"无合格信号" / all_empty=六领域全空才推 / silent=全静默
EARLY_BIRD_PUSH_EMPTY=per_domain
# 发送失败后的重试间隔（分钟）与最大重试次数
EARLY_BIRD_PUSH_RETRY_INTERVAL_MINUTES=15
EARLY_BIRD_PUSH_MAX_RETRIES=8
